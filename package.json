{
  "name": "finana",
  "private": true,
  "description": "Só para gerar o CSS do Tailwind; o app em si é Python.",
  "scripts": {
    "css": "tailwindcss -i tailwind.input.css -o finana/static/tailwind.css --minify",
    "css:watch": "tailwindcss -i tailwind.input.css -o finana/static/tailwind.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
